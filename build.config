# Build optimization configuration for Flutter Web
# Reduces bundle size and improves build performance

# Compiler optimizations
--dart2js-optimization=O4

# Tree shaking - removes unused code
--tree-shake-icons

# Split deferred components - reduces initial load
--split-debug-info=build/app/split-debug-info

# No source maps in production (reduces size by ~40%)
--no-source-maps

# Minification
--minify

# Skip service worker generation (we have custom sw.js)
--pwa-strategy=none

# Use HTML renderer (smaller bundle than CanvasKit)
--web-renderer=html

# Optimization level
-O4
